<!--
  Generated by `cargo wix init -p wvgc-desktop`, then hand-edited to:
    - install wvgc-cli.exe alongside wvgc-desktop.exe (both binaries in one
      installer — see repo-root task: viewer + cli + main program merged
      into a single installer),
    - add a Start Menu shortcut using the Watermelon icon,
    - set the Add/Remove Programs icon,
    - rename the product from the crate name to the real product name.

  TODO(file_assoc): once the desktop/src/file_assoc module lands (currently
  deferred — see desktop/src/main.rs), register .svg/.xml file associations
  here via a <ProgIcon>/<Extension> block under a new Component.
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Watermelon Vector Converter'
        UpgradeCode='96493FF0-1F2D-4DAA-AF80-64AC37B139C7'
        Manufacturer='Suhail Muzaffari'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Watermelon Vector Converter — SVG &lt;-&gt; Android VectorDrawable converter and viewer'
            Manufacturer='Suhail Muzaffari'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Watermelon Vector Converter Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Watermelon Vector Converter'>
                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='8E2A93EA-A953-4BC4-AB57-ACAC0C91F197' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='wvgc-desktop.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\wvgc-desktop.exe'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='binary1' Guid='*'>
                            <File
                                Id='exe1'
                                Name='wvgc-cli.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\wvgc-cli.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Watermelon Vector Converter'>
                    <Component Id='ApplicationShortcut' Guid='*'>
                        <Shortcut
                            Id='ApplicationStartMenuShortcut'
                            Name='Watermelon Vector Converter'
                            Description='Convert between SVG and Android VectorDrawable XML'
                            Target='[Bin]wvgc-desktop.exe'
                            WorkingDirectory='Bin'
                            Icon='ProductICO'/>
                        <RemoveFolder Id='ApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\Watermelon Vector Converter'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs the converter, viewer, and command-line tool.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <ComponentRef Id='ApplicationShortcut'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location (and wvgc-cli) to the PATH system environment variable.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='..\icons\watermelon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
