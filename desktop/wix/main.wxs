<!--
  Generated by `cargo wix init -p wvgc-desktop`, then hand-edited to:
    - install wvgc-cli.exe alongside wvgc-desktop.exe (both binaries in one
      installer — see repo-root task: viewer + cli + main program merged
      into a single installer),
    - add a Start Menu shortcut using the Watermelon icon,
    - set the Add/Remove Programs icon,
    - rename the product from the crate name to the real product name,
    - install watermelon_svg.ico / watermelon_xml.ico alongside the
      binaries, for the per-file-type icons registered by
      desktop/src/file_assoc/mod.rs (that module writes the actual
      registry associations at runtime on first ordinary launch — this
      installer's job is only to make sure the two .ico files exist next
      to wvgc-desktop.exe for it to point at, not to write the
      associations itself).
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Watermelon Vector Converter'
        UpgradeCode='96493FF0-1F2D-4DAA-AF80-64AC37B139C7'
        Manufacturer='Suhail Muzaffari'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Watermelon Vector Converter — SVG &lt;-&gt; Android VectorDrawable converter and viewer'
            Manufacturer='Suhail Muzaffari'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Watermelon Vector Converter Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Watermelon Vector Converter'>
                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='8E2A93EA-A953-4BC4-AB57-ACAC0C91F197' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='wvgc-desktop.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\wvgc-desktop.exe'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='binary1' Guid='*'>
                            <File
                                Id='exe1'
                                Name='wvgc-cli.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\wvgc-cli.exe'
                                KeyPath='yes'/>
                        </Component>
                        <!-- Per-file-type icons for file_assoc/mod.rs's
                             registered associations. Installed next to the
                             exe (file_assoc::register_current_exe resolves
                             these paths relative to std::env::current_exe,
                             i.e. this same Bin directory) rather than
                             embedded as exe resources, so no rebuild of
                             wvgc-desktop.exe itself is needed if an icon
                             is ever swapped later — same reasoning as
                             keeping ProductICO's source file external
                             below. Absolute paths via WiX environment-
                             variable references, for the same
                             candle/light working-directory-ambiguity
                             reason ProductICO's SourceFile below uses one. -->
                        <Component Id='binaryIconSvg' Guid='*'>
                            <File
                                Id='iconSvg'
                                Name='watermelon_svg.ico'
                                DiskId='1'
                                Source='$(env.WATERMELON_ICON_SVG_ICO)'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='binaryIconXml' Guid='*'>
                            <File
                                Id='iconXml'
                                Name='watermelon_xml.ico'
                                DiskId='1'
                                Source='$(env.WATERMELON_ICON_XML_ICO)'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Watermelon Vector Converter'>
                    <Component Id='ApplicationShortcut' Guid='*'>
                        <Shortcut
                            Id='ApplicationStartMenuShortcut'
                            Name='Watermelon Vector Converter'
                            Description='Convert between SVG and Android VectorDrawable XML'
                            Target='[Bin]wvgc-desktop.exe'
                            WorkingDirectory='Bin'
                            Icon='ProductICO'/>
                        <RemoveFolder Id='ApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue
                            Root='HKCU'
                            Key='Software\Watermelon Vector Converter'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs the converter, viewer, and command-line tool.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <ComponentRef Id='binaryIconSvg'/>
            <ComponentRef Id='binaryIconXml'/>
            <ComponentRef Id='ApplicationShortcut'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location (and wvgc-cli) to the PATH system environment variable.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- Both a crate-root-relative path (..\icons\watermelon.ico) and a
             wxs-directory-relative path (wix\watermelon.ico) failed here
             with "LGHT0103: The system cannot find the file", since
             candle/light's actual working directory when invoked by
             cargo-wix doesn't match either assumption reliably. An
             absolute path via a WiX environment-variable reference
             sidesteps the ambiguity: the CI workflow sets
             WATERMELON_ICON_ICO to an absolute path before calling
             `cargo wix`. -->
        <Icon Id='ProductICO' SourceFile='$(env.WATERMELON_ICON_ICO)'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
